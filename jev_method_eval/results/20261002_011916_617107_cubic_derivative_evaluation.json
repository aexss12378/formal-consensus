          "problem_text": "Find the slope of the tangent to the curve y = 3 + 4x² − 2x³ at the point where x = a.",
          "lean_imports": [
            "import Mathlib"
          ],
          "lean_statement": "(a : ℝ) : HasDerivAt (fun y : ℝ => 3 + 4 * y ^ 2 - 2 * y ^ 3) (8 * a - 6 * a ^ 2) a",
          "proof_body": "by\n  have hid : HasDerivAt (fun y : ℝ => y) 1 a := hasDerivAt_id a\n  have h2 : HasDerivAt (fun y : ℝ => y ^ 2) (2 * a) a := by\n    simpa using hid.pow 2\n  have h3 : HasDerivAt (fun y : ℝ => y ^ 3) (3 * a ^ 2) a := by\n    simpa using hid.pow 3\n  have hpoly : HasDerivAt (fun y : ℝ => 4 * y ^ 2 - 2 * y ^ 3)\n      (4 * (2 * a) - 2 * (3 * a ^ 2)) a :=\n    (h2.const_mul 4).sub (h3.const_mul 2)\n  have hd : HasDerivAt (fun y : ℝ => 3 + (4 * y ^ 2 - 2 * y ^ 3))\n      (2 * a * (4 - 3 * a)) a := by\n    convert (hasDerivAt_const a (3 : ℝ)).add hpoly using 1 <;> ring\n  have hfun : (fun y : ℝ => 3 + 4 * y ^ 2 - 2 * y ^ 3) =\n      (fun y : ℝ => 3 + (4 * y ^ 2 - 2 * y ^ 3)) := by\n    funext y\n    ring\n  rw [hfun]\n  convert hd using 1 <;> ring"
        },
