          "proof_body": "by\n  apply hasDerivAt_iff_tendsto_slope_zero.mpr\n  have hc : ContinuousAt\n      (fun h : ℝ => 8 * a + 4 * h - 6 * a ^ 2 - 6 * a * h - 2 * h ^ 2) 0 := by\n    fun_prop\n  have hlim : Filter.Tendsto\n      (fun h : ℝ => 8 * a + 4 * h - 6 * a ^ 2 - 6 * a * h - 2 * h ^ 2)\n      (nhdsWithin (0 : ℝ) {(0 : ℝ)}ᶜ) (nhds (8 * a - 6 * a ^ 2)) := by\n    have h := hc.tendsto.mono_left\n      (nhdsWithin_le_nhds : nhdsWithin (0 : ℝ) {(0 : ℝ)}ᶜ ≤ nhds (0 : ℝ))\n    simpa using h\n  apply hlim.congr'\n  filter_upwards [self_mem_nhdsWithin] with h hh\n  have hne : h ≠ 0 := by simpa using hh\n  simp only [smul_eq_mul]\n  field_simp [hne]\n  ring"
