    {
      "case_id": "absolute_001",
      "problem_id": "midterm_q2_absolute_limit",
      "reference": {
        "primary_technique": "One-Sided Limits",
        "rationale": "先把左側表達式化為 −3x − 4、右側化為 4 − x，各求單側極限為 8，再由左右極限相等得到原極限。絕對值分情況與線性函數的連續性用於求各側極限，主要架構為左右極限法。",
        "case_types": [
          "same_method_variant",
          "different_primary_methods",
          "auxiliary_method"
        ],
        "status": "predefined"
      },
      "request": {
        "model": "typesafe/jev-1.13",
        "state": {
          "problem_text": "Find the limit, if it exists. If the limit does not exist, explain why.\nlim_{x→−4} (|x + 4| − 2x)",
          "lean_imports": [
            "import Mathlib"
          ],
          "lean_statement": "Filter.Tendsto (fun x : ℝ => |x + 4| - 2 * x) (nhdsWithin (-4) {(-4 : ℝ)}ᶜ) (nhds (8 : ℝ))",
          "proof_body": "by\n  have hleft : Filter.Tendsto (fun x : ℝ => |x + 4| - 2 * x)\n      (nhdsWithin (-4) (Set.Iio (-4))) (nhds (8 : ℝ)) := by\n    have hc : ContinuousAt (fun x : ℝ => -3 * x - 4) (-4) := by fun_prop\n    have hlim : Filter.Tendsto (fun x : ℝ => -3 * x - 4)\n        (nhdsWithin (-4) (Set.Iio (-4))) (nhds (8 : ℝ)) := by\n      have h := hc.tendsto.mono_left\n        (nhdsWithin_le_nhds : nhdsWithin (-4) (Set.Iio (-4)) ≤ nhds (-4 : ℝ))\n      norm_num at h\n      simpa using h\n    apply hlim.congr'\n    filter_upwards [self_mem_nhdsWithin] with x hx\n    have hneg : x + 4 < 0 := by change x < -4 at hx; linarith\n    rw [abs_of_neg hneg]\n    ring\n  have hright : Filter.Tendsto (fun x : ℝ => |x + 4| - 2 * x)\n      (nhdsWithin (-4) (Set.Ioi (-4))) (nhds (8 : ℝ)) := by\n    have hc : ContinuousAt (fun x : ℝ => 4 - x) (-4) := by fun_prop\n    have hlim : Filter.Tendsto (fun x : ℝ => 4 - x)\n        (nhdsWithin (-4) (Set.Ioi (-4))) (nhds (8 : ℝ)) := by\n      have h := hc.tendsto.mono_left\n        (nhdsWithin_le_nhds : nhdsWithin (-4) (Set.Ioi (-4)) ≤ nhds (-4 : ℝ))\n      norm_num at h\n      simpa using h\n    apply hlim.congr'\n    filter_upwards [self_mem_nhdsWithin] with x hx\n    have hpos : 0 ≤ x + 4 := by change -4 < x at hx; linarith\n    rw [abs_of_nonneg hpos]\n    ring\n  rw [← nhdsLT_sup_nhdsGT]\n  exact hleft.sup hright"
        },
        "questions": {
