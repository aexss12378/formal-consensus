      "lean_statement": "∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x : ℝ,\n      0 < |x - 4| → |x - 4| < δ → |(x ^ 2 - 2 * x - 8) / (x - 4) - 6| < ε",
      "proof_body": "by\n  intro ε hε\n  refine ⟨ε, hε, ?_⟩\n  intro x hx hxδ\n  have hxne : x - 4 ≠ 0 := abs_pos.mp hx\n  have hfac : x ^ 2 - 2 * x - 8 = (x - 4) * (x + 2) := by ring\n  have hval : (x ^ 2 - 2 * x - 8) / (x - 4) = x + 2 := by\n    rw [hfac]\n    field_simp [hxne]\n  calc\n    |(x ^ 2 - 2 * x - 8) / (x - 4) - 6| = |(x + 2) - 6| := by rw [hval]\n    _ = |x - 4| := by\n      congr 1\n      ring\n    _ < ε := hxδ"
